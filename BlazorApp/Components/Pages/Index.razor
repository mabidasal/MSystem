@code {
    // ── File upload ───────────────────────────────────
    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await DataService.LoadFromExcelAsync(stream, file.Name);
        StateHasChanged();
    }

    // ── Capacity helpers ──────────────────────────────
    private string CapacityClass(int pct)      => pct >= 90 ? "val-danger" : pct >= 70 ? "val-warn" : "val-ok";
    private string CapacityBarClass(int pct)   => pct >= 90 ? "cap-bar-danger" : pct >= 70 ? "cap-bar-warn" : "cap-bar-ok";
    private string CapacityBadgeClass(int pct) => pct >= 90 ? "badge-full" : pct >= 70 ? "badge-busy" : "badge-avail";
    private string CapacityLabel(int pct)      => pct >= 90 ? "Full" : pct >= 70 ? "Busy" : "Available";

    // ── Accordion state ───────────────────────────────
    private bool showWorkload      = true;
    private bool showTasks         = false;
    private bool showAvailCalendar = false;
    private bool showLeaveCalendar = false;

    private void ToggleWorkload()      => showWorkload      = !showWorkload;
    private void ToggleTasks()         => showTasks         = !showTasks;
    private void ToggleAvailCalendar() => showAvailCalendar = !showAvailCalendar;
    private void ToggleLeaveCalendar() => showLeaveCalendar = !showLeaveCalendar;

    // ── Calendar dates ────────────────────────────────
    private DateOnly AvailDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly LeaveDate = DateOnly.FromDateTime(DateTime.Today);

    private void AvailPrevMonth() => AvailDate = AvailDate.AddMonths(-1);
    private void AvailNextMonth() => AvailDate = AvailDate.AddMonths(1);
    private void LeavePrevMonth() => LeaveDate = LeaveDate.AddMonths(-1);
    private void LeaveNextMonth() => LeaveDate = LeaveDate.AddMonths(1);

    // ── Calendar helpers ──────────────────────────────
    private List<DateOnly?> GetCalendarCells(DateOnly date)
    {
        var cells = new List<DateOnly?>();
        var first = new DateOnly(date.Year, date.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(date.Year, date.Month);
        for (int i = 0; i < (int)first.DayOfWeek; i++) cells.Add(null);
        for (int d = 1; d <= daysInMonth; d++) cells.Add(new DateOnly(date.Year, date.Month, d));
        return cells;
    }

    private List<LeaveRecord> GetLeavesForDay(DateOnly day) =>
        DataService.Leaves.Where(l => day >= l.StartDate && day <= l.EndDate).ToList();

    private List<LeaveRecord> GetLeavesForMonth(DateOnly date) =>
        DataService.Leaves
            .Where(l => (l.StartDate.Month == date.Month && l.StartDate.Year == date.Year)
                     || (l.EndDate.Month   == date.Month && l.EndDate.Year   == date.Year))
            .OrderBy(l => l.StartDate)
            .ToList();

    // ── Leave chip class ──────────────────────────────
    private string GetLeaveChipClass(string leaveType) => leaveType switch
    {
        "Vacation" => "chip-vacation",
        "Sick"     => "chip-sick",
        "WFH"      => "chip-wfh",
        _          => "chip-wfh"
    };
}